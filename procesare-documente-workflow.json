      "id": "merge-date-extrase",
      "name": "Date extrase",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2320,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst target = (items.map(i => i.json.societate).find(s => s) ||\n  $('Documente ca iteme').first().json.targetCompany || 'NECUNOSCUT');\n\nfunction norm(s) {\n  return (s || '').toString().toUpperCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^A-Z0-9 ]+/g, ' ')\n    .replace(/\\b(S C|S R L|SRL|SC|SA|S A|PFA|SOCIETATE|COMPANIE|FIRMA)\\b/g, ' ')\n    .replace(/\\s+/g, ' ').trim();\n}\nfunction lev(a, b) {\n  const m = a.length, n = b.length;\n  const d = Array.from({ length: m + 1 }, (_, i) => { const row = new Array(n + 1).fill(0); row[0] = i; return row; });\n  for (let j = 1; j <= n; j++) d[0][j] = j;\n  for (let i = 1; i <= m; i++) {\n    for (let j = 1; j <= n; j++) {\n      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n    }\n  }\n  return d[m][n];\n}\nfunction sim(a, b) {\n  const x = norm(a), y = norm(b);\n  if (!x || !y) return 0;\n  return 1 - lev(x, y) / Math.max(x.length, y.length);\n}\nfunction tokenScore(a, b) {\n  const A = new Set(norm(a).split(' ').filter(t => t.length > 0));\n  const B = new Set(norm(b).split(' ').filter(t => t.length > 0));\n  if (!A.size || !B.size) return 0;\n  let inter = 0;\n  for (const t of A) if (B.has(t)) inter++;\n  return inter / Math.max(A.size, B.size);\n}\nfunction nameSim(a, b) { return Math.max(sim(a, b), tokenScore(a, b)); }\n\nconst tranzactii = [];\nfor (const it of items) {\n  const j = it.json;\n  if ((j.categorie || j.tip) === 'extras_bancar' && j.date_document && Array.isArray(j.date_document.tranzactii)) {\n    for (const tr of j.date_document.tranzactii) {\n      tranzactii.push({ ...tr, extras: j.fisier });\n    }\n  }\n}\n\nfunction gasesteTranzactie(nume, sumaDoc, tipDorit) {\n  let best = null;\n  for (const tr of tranzactii) {\n    if (tipDorit && tr.tip && norm(tr.tip) !== tipDorit) continue;\n    const s = nameSim(tr.contraparte || tr.descriere || '', nume);\n    const suma = Math.abs(Number(tr.suma) || 0);\n    const total = Math.abs(Number(sumaDoc) || 0);\n    const sumaOk = total > 0 && suma > 0 && Math.abs(suma - total) <= Math.max(1, total * 0.01);\n    const score = s + (sumaOk ? 1 : 0);\n    if (!best || score > best.score) best = { tr, s, sumaOk, score };\n  }\n  if (best && best.s >= 0.7 && (best.sumaOk || best.s >= 0.9)) {\n    return { in_extras: true, tranzactie_potrivita: {\n      data: best.tr.data || null,\n      contraparte: best.tr.contraparte || best.tr.descriere || null,\n      suma: best.tr.suma === undefined ? null : best.tr.suma,\n      tip: best.tr.tip || null,\n      extras: best.tr.extras || null,\n      scor_nume: Number(best.s.toFixed(2)),\n      suma_corecta: best.sumaOk\n    } };\n  }\n  return { in_extras: false, tranzactie_potrivita: null };\n}\n\nreturn items.map(it => {\n  const j = it.json;\n  const categorie = j.categorie || j.tip || 'necunoscut';\n  const v = { observatii: [] };\n  const dd = j.date_document || {};\n  if (categorie === 'factura_iesire') {\n    const furn = (dd.furnizor && dd.furnizor.nume) || '';\n    const client = (dd.cumparator && dd.cumparator.nume) || '';\n    v.emitent_confirmat = nameSim(furn, target) >= 0.7;\n    if (!v.emitent_confirmat) v.observatii.push('Emitentul \"' + furn + '\" nu corespunde societatii din numele ZIP-ului \"' + target + '\"');\n    Object.assign(v, gasesteTranzactie(client, dd.total, 'CREDIT'));\n    if (!v.in_extras && client) v.observatii.push('Nu am gasit in extrasul bancar o incasare (credit) de la clientul \"' + client + '\" cu suma facturii');\n    v.stare = (v.emitent_confirmat && v.in_extras) ? 'validat' : 'de_verificat';\n  } else if (categorie === 'factura_intrare') {\n    const furn = (dd.furnizor && dd.furnizor.nume) || '';\n    const cump = (dd.cumparator && dd.cumparator.nume) || '';\n    v.beneficiar_confirmat = nameSim(cump, target) >= 0.7;\n    if (!v.beneficiar_confirmat) v.observatii.push('Cumparatorul \"' + cump + '\" nu corespunde societatii \"' + target + '\"');\n    Object.assign(v, gasesteTranzactie(furn, dd.total, 'DEBIT'));\n    if (!v.in_extras && furn) v.observatii.push('Nu am gasit in extrasul bancar o plata (debit) catre furnizorul \"' + furn + '\" cu suma facturii');\n    v.stare = (v.beneficiar_confirmat && v.in_extras) ? 'validat' : 'de_verificat';\n  } else if (categorie === 'extras_bancar') {\n    v.stare = 'procesat';\n    v.numar_tranzactii = Array.isArray(dd.tranzactii) ? dd.tranzactii.length : 0;\n  } else if (categorie === 'altul') {\n    v.stare = 'ignorat';\n  } else {\n    v.stare = 'procesat';\n  }\n  return { json: { ...j, categorie, validare: v } };\n});"
      },
      "id": "code-validare-vs-extras-bancar",
      "name": "Validare vs extras bancar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2540,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst docs = items.map(i => i.json);\nconst target = docs.map(d => d.societate).find(s => s) ||\n  $('Documente ca iteme').first().json.targetCompany || 'NECUNOSCUT';\n\nconst distributie = {};\nfor (const d of docs) distributie[d.categorie] = (distributie[d.categorie] || 0) + 1;\nconst validat = docs.filter(d => d.validare && d.validare.stare === 'validat').length;\nconst deVerificat = docs.filter(d => d.validare && d.validare.stare === 'de_verificat').length;\n\nfunction csvCell(v) {\n  if (v === null || v === undefined) return '';\n  let s = (typeof v === 'object') ? JSON.stringify(v) : String(v);\n  if (/[\",;\\n]/.test(s)) s = '\"' + s.replace(/\"/g, '\"\"') + '\"';\n  return s;\n}\nfunction parte(dd, cheie) { return dd && dd[cheie] && dd[cheie].nume ? dd[cheie].nume : ''; }\n\nconst header = ['fisier', 'categorie', 'emitent_furnizor', 'cumparator_beneficiar', 'numar_document', 'data', 'total', 'moneda', 'stare', 'in_extras_bancar', 'observatii'];\nconst rows = docs.map(d => {\n  const dd = d.date_document || {};\n  const val = d.validare || {};\n  return [\n    d.fisier,\n    d.categorie,\n    parte(dd, 'furnizor'),\n    parte(dd, 'cumparator') || dd.nume_magazin || '',\n    dd.numar_factura || dd.numar_nir || dd.numar_raport || '',\n    dd.data_emitere || dd.data || '',\n    (dd.total === undefined || dd.total === null) ? (dd.vanzari_totale === undefined ? '' : dd.vanzari_totale) : dd.total,\n    dd.moneda || '',\n    val.stare || '',\n    val.in_extras ? 'da' : 'nu',\n    (val.observatii || []).join(' | ')\n  ].map(csvCell).join(',');\n});\nconst csv = [header.join(','), ...rows].join('\\n');\nconst slug = target.toString().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || 'raport';\n\nreturn [{ json: {\n  raport: {\n    societate: target,\n    total_documente: docs.length,\n    distributie,\n    facturi_validate_in_extras: validat,\n    documente_de_verificat: deVerificat,\n    documente: docs\n  },\n  csv_nume: 'raport_' + slug + '.csv',\n  csv_base64: Buffer.from(csv, 'utf8').toString('base64')\n} }];"
      },
