{
  "name": "Procesare documente contabile din ZIP",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "proceseaza-documente",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-primesc-zip",
      "name": "Primesc ZIP",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -360,
        0
      ],
      "webhookId": "proceseaza-documente"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst bin = item.binary && item.binary.data ? item.binary.data : null;\nconst zipName = (bin && bin.fileName) || item.json.fileName || 'necunoscut.zip';\nconst targetCompany = zipName.replace(/\\.zip$/i, '').replace(/[_-]+/g, ' ').trim();\nreturn [{ json: { ...item.json, targetCompany, zip: zipName }, binary: item.binary }];"
      },
      "id": "code-config-din-nume-zip",
      "name": "Config din nume ZIP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ]
    },
    {
      "parameters": {
        "operation": "unzip",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "unzip-zip",
      "name": "Dezarhiveaza ZIP",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const targetCompany = $('Config din nume ZIP').first().json.targetCompany;\nconst out = [];\nfor (const item of $input.all()) {\n  const binaries = item.binary || {};\n  for (const key of Object.keys(binaries)) {\n    const bin = binaries[key];\n    const fileName = bin.fileName || key;\n    if (/\\.zip$/i.test(fileName)) continue;\n    out.push({ json: { fileName, mimeType: bin.mimeType || '' }, binary: { data: bin } });\n  }\n}\nif (!out.length) throw new Error('ZIP-ul nu contine documente (sau contine doar alte arhive).');\nreturn out;"
      },
      "id": "code-documente-ca-iteme",
      "name": "Documente ca iteme",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ]
    },
